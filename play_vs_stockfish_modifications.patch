 // Functions related to playing against Stockfish
+function updatePlaySkill(value) {
+  const elo = parseInt(value, 10);
+  state.play.skill = clamp(elo, 700, 3000);
+  configureEngineStrength(state.play.skill);
+  renderPlayPanel();
+}
+
+function updatePlayTime(value) {
+  state.play.timeControl = value;
+  renderPlayPanel();
+}
+
+function startPlayGame() {
+  state.play.active = true;
+  // Reset game state or reuse current position
+  // Example: use current setup position for play
+  state.analysis.currentFen = state.setupFen;
+  configureEngineStrength(state.play.skill);
+  // Additional logic to handle time controls could be added here
+  renderPlayPanel();
+}
+
+function stopPlayGame() {
+  state.play.active = false;
+  // Stop timers or engine thinking if needed
+  renderPlayPanel();
+}
+
+function configureEngineStrength(elo) {
+  if (!state.engine.worker) {
+    return;
+  }
+  // Limit Stockfish strength by Elo rating
+  const cmd = (msg) => state.engine.worker.postMessage(msg);
+  cmd('setoption name UCI_LimitStrength value true');
+  cmd(`setoption name UCI_Elo value ${elo}`);
+}
+
+function renderPlayPanel() {
+  const { skill, timeControl, active } = state.play;
+  const playMarkup = `
+    <article class="lesson-section">
+      <div class="lesson-section-header">
+        <h3 class="lesson-section-title">Play vs Stockfish</h3>
+      </div>
+      <div class="stack-grid">
+        <div class="field-row">
+          <label class="field-label" for="engineSkillSlider">Engine strength (Elo)</label>
+          <input
+            type="range"
+            id="engineSkillSlider"
+            min="700"
+            max="3000"
+            step="50"
+            value="${skill}"
+            data-action="set-play-skill"
+          >
+          <div class="field-value">${skill}</div>
+        </div>
+        <div class="field-row">
+          <label class="field-label" for="playTimeSelect">Time control</label>
+          <select id="playTimeSelect" class="field-select" data-action="set-play-time">
+            <option value="none" ${timeControl === 'none' ? 'selected' : ''}>No clock</option>
+            <option value="1+0" ${timeControl === '1+0' ? 'selected' : ''}>1+0</option>
+            <option value="3+2" ${timeControl === '3+2' ? 'selected' : ''}>3+2</option>
+            <option value="5+0" ${timeControl === '5+0' ? 'selected' : ''}>5+0</option>
+            <option value="10+0" ${timeControl === '10+0' ? 'selected' : ''}>10+0</option>
+          </select>
+        </div>
+        <div class="action-row">
+          ${active
+            ? `<button type="button" class="action-button danger" data-action="stop-play">Resign</button>`
+            : `<button type="button" class="action-button primary" data-action="start-play">Start</button>`}
+        </div>
+      </div>
+    </article>
+  `;
+  withPreservedScroll(dom.controlPaneScroll, () => {
+    dom.playPanel.innerHTML = playMarkup;
